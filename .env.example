# 复制为 .env 后按需修改。.env 不提交 Git。

# ---- 应用 ----
APP_NAME=图片三维重建系统
API_V1_PREFIX=/api/v1
# 生产请改为随机长字符串
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 数据库（SQLite 原型 / PostgreSQL 二选一）----
# SQLite（默认，本地磁盘；容器删除会丢失，请配合 scripts/backup_db.sh 定期备份）
DATABASE_URL=sqlite:////var/lib/recon-data/recon.db
# PostgreSQL 示例（推荐生产使用；注意本容器 /dev/shm 限制见 docs/environment-report.md）
# DATABASE_URL=postgresql+psycopg2://recon:recon_pass_2024@127.0.0.1:5432/recon_db

# ---- Redis / 任务队列 ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- 文件存储 ----
# 用户数据根目录（应放在持久化目录；NFS home）
DATA_DIR=/data/home/2024090904028/reconstration/3d-reconstruction-system/data
# 临时/中间结果目录（本地磁盘更快；容器删除丢失，可随时清空）
SCRATCH_DIR=/var/lib/recon-data/scratch

# ---- 上传限制 ----
MAX_UPLOAD_FILE_MB=200
MAX_PROJECT_TOTAL_MB=2048
MAX_PROJECT_IMAGES=300
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,tif,tiff,bmp,webp

# ---- 重建引擎 ----
# colmap = 真实 COLMAP；mock = 模拟管线（无 COLMAP 环境演示用）
RECON_MODE=colmap
COLMAP_BIN=colmap
# CUDA 支持自动检测；显式覆盖: 1 强制开 / 0 强制关
RECON_USE_GPU=auto
# 重建质量预设: fast | standard | high
DEFAULT_RECON_PRESET=standard

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 日志 ----
LOG_LEVEL=INFO
